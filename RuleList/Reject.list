# Surge 的自动 REJECT 保护丢包，防止应用循环请求
IP-CIDR,0.0.0.0/32

# > 拒绝请求；与 REJECT 不同，此策略会默默地丢弃请求
AND,((PROTOCOL,UDP), (DEST-PORT,443))

# app 测试 app-measurement.com
DOMAIN-SUFFIX,app-measurement.com

# youtube dler原始版本
URL-REGEX,https?:\/\/.+\.googlevideo\.com\/.+?)(&ctier=L|\/ctier\/L)((&|\/).+?)(,ctier|%2Cctier)((,|%2C)
URL-REGEX,https?:\/\/.+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+(&oad|ctier)
URL-REGEX,https?:\/\/.+\.googlevideo\.com\/ptracking\?pltype=adhost
URL-REGEX,https?:\/\/.+\.youtube\.com\/api\/stats\/ads
URL-REGEX,https?:\/\/.+\.youtube\.com\/get_midroll_
URL-REGEX,https?:\/\/.+\.youtube\.com\/(pagead|ptracking)\/
URL-REGEX,https?:\/\/.+\.youtube\.com\/_get_ads
URL-REGEX,https?:\/\/premiumyva\.appspot\.com\/vmclickstoadvertisersite
URL-REGEX,https?:\/\/s0\.2mdn\.net\/ads\/
URL-REGEX,https?:\/\/stats\.tubemogul\.com\/stats\/
URL-REGEX,https?:\/\/youtubei\.googleapis\.com\/.+ad_break
URL-REGEX,https?:\/\/youtubei\.googleapis\.com\/youtubei\/.+(ad|log)
URL-REGEX,https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?.*adformat
URL-REGEX,https?:\/\/(?!redirector)[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+)(ctier=L)(&.+)
# BlueGrave 库中
AND,((PROTOCOL,UDP),(OR,((DOMAIN-SUFFIX,googlevideo.com),(DOMAIN-SUFFIX,gvt1.com),(DOMAIN-SUFFIX,cdninstagram.com))))

# Block P2P
AND,((PROTOCOL,UDP),(OR,((DOMAIN-KEYWORD,bilibili),(DOMAIN-KEYWORD,biliapi),(DOMAIN-KEYWORD,mcdn),(DOMAIN-KEYWORD,douyu))))
AND,((PROTOCOL,TCP),(OR,((DOMAIN-KEYWORD,stun),(DOMAIN-KEYWORD,douyu))))

# 滴滴出行 去广告
//01 安全提示横幅
URL-REGEX,^https:\/\/guard\.sec\.xiaojukeji\.com\/api\/guard\/psg\/v2\/getShieldStatus
//02 底部打车&代价推荐
URL-REGEX,^https:\/\/conf\.diditaxi\.com\.cn\/one
//03 福利专区-金融服务-公交-骑车-滴滴乐园
URL-REGEX,^https:\/\/conf\.diditaxi\.com\.cn\/nav\/widget
//04 接送机-优惠商城
URL-REGEX,^https:\/\/api\.udache\.com\/gulfstream
//05 主页 领任务
URL-REGEX,^https:\/\/conf\.diditaxi\.com\.cn\/api\/(component|fusion|dynamicmodule|usercenter)
URL-REGEX,^https:\/\/conf\.diditaxi\.com\.cn\/dynamic
//06 主页 非主流式悬浮挂件
URL-REGEX,^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget
//07 商城
URL-REGEX,^https:\/\/shop-gw\.chengxinyouxuan\.com\/(route|indexConfig|apolloConfig|getShopTuanInfos)
//08 开屏广告
URL-REGEX,^https:\/\/img-ys011\.didistatic\.com\/static
//09 骑行
URL-REGEX,^https:\/\/pt-starimg\.didistatic\.com\/static

# 中国联通 去开屏
DOMAIN-SUFFIX,m1.ad.10010.com

# 中国电信 去开屏
DOMAIN,ad.21cn.com
DOMAIN,ad.k.21cn.com
DOMAIN,admarket.21cn.com
DOMAIN,adshows.21cn.com

# 拼多多 去开屏
URL-REGEX,^https?:\/\/api\.(pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash

# 美团 去广告
DOMAIN,portal-portm.meituan.com
URL-REGEX,^https?:\/\/img\.meituan\.net\/(bizad|brandCpt)\/\w+\.(png|jpg)
URL-REGEX,^https?:\/\/peisongapi\.meituan\.com\/client\/getInitiateImage
URL-REGEX,^https?:\/\/img\.meituan\.net\/(adunion|display|midas)\/\w+\.(gif|jpg|jpg\.webp)$
URL-REGEX,^https?:\/\/(s3plus|flowplus)\.meituan\.net\/v\d\/\w+\/linglong\/\w+\.(gif|jpg|mp4)
URL-REGEX,^https?:\/\/p\d\.meituan\.net\/(bizad|wmbanner)\/\w+\.jpg
URL-REGEX,^https?:\/\/p\d\.meituan\.net\/movie\/\w+\.jpg\?may_covertWebp


